# Copy to .env and fill in. Never commit .env.
# The only value you strictly need to run locally is GROQ_API_KEY.

# ---- Core ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Agent LLM (routing) ----
# REQUIRED. This is the only key you must set. Free: https://console.groq.com
GROQ_API_KEY=
# Verify availability: https://console.groq.com/docs/models
# Alternatives on this account: openai/gpt-oss-20b, openai/gpt-oss-120b
# Reasoning settings below apply to reasoning models (qwen). Leave
# AGENT_REASONING_FORMAT=hidden so chain-of-thought never reaches the user.
GROQ_MODEL=qwen/qwen3.8-27b
AGENT_TEMPERATURE=0.6
AGENT_TOP_P=0.95
AGENT_MAX_TOKENS=2048
AGENT_REASONING_EFFORT=default
AGENT_REASONING_FORMAT=hidden

# ---- Therapist-voice LLM ----
# groq   = works immediately with the key above. Use this if unsure.
# ollama = local MedGemma; requires Ollama installed AND the model pulled:
#          ollama pull alibayram/medgemma:4b
#          Without both, every reply is a generic fallback message.
LLM_PROVIDER=groq
OLLAMA_MODEL=alibayram/medgemma:4b
OLLAMA_HOST=http://localhost:11434

# ---- Embeddings ----
# Powers exam-corpus grounding only. If neither option is available the exam tool
# quietly falls back to general support - the app still runs.
# local       = sentence-transformers; needs `uv sync --extra local` (~2GB of torch)
# huggingface = hosted Inference API; needs HUGGINGFACE_API_KEY; fits a serverless bundle
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=

# ---- Safety ----
# Leave false unless you intend to place real phone calls.
EMERGENCY_CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CONTACT=
DEFAULT_CRISIS_REGION=INTL

# ---- Therapist locator ----
# Without this the locator tells the user it cannot search, rather than inventing names.
SERPAPI_API_KEY=

# ---- API ----
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MINUTE=20
